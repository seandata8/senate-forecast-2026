# Python bytecode / caches
__pycache__/
*.py[cod]
*$py.class

# Packaging / build
build/
dist/
*.egg-info/
*.egg
.eggs/
wheels/

# Virtual environments
.venv/
venv/
env/

# Environment variables / secrets
.env
.env.*
!.env.example

# Testing / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# Type checkers / linters
.mypy_cache/
.ruff_cache/
.pyright/

# Jupyter
.ipynb_checkpoints/

# IDEs / editors
.idea/
.vscode/
*.swp

# OS files
.DS_Store
Thumbs.db

# Course instructions
instructions/

# Raw CES files are over GitHub's 100 MB limit; scripts/01-download_election_data.py downloads them.
data/01-raw_data/CCES*
# Unfinished downloads
*.part

# Model answers cached by silicon.py (paid for with our own API keys); kept on each person's computer only
cache/

# Quarto's working files while it builds the website
/.quarto/
**/*.quarto_ipynb
